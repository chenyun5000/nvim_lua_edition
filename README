1.install neovim
a).prepare env for compile && python
sudo apt-get update
sudo apt-get install git build-essential cmake gettext libtool libtool-bin autoconf automake cmake g++ pkg-config unzip curl

b).make a bin directory to store your tools.
mkdir ~/bin/
echo "PATH=~/bin:$PATH" >> ~/.bashrc
source ~/.bashrc

b).featch source code of neovim and compile
git clone https://github.com/neovim/neovim.git
cd neovim/
git checkout release-0.11
make CMAKE_BUILD_TYPE=Release CMAKE_INSTALL_PREFIX=$HOME/ install

2.install python3
python3 --version
//python version should >= 3.8,my version is(Python 3.12.3).
//install other python tools
sudo apt install python3-pip python3-dev python3-venv

3.add settings for nvim
a)Prepare env and tools:
sudo apt install tree nodejs ripgrep

b).new a config dir and files
mkdir -p ~/.config/nvim/lua/config/plugins/

touch ~/.config/nvim/init.lua
touch ~/.config/nvim/lua/config/lazy.lua
touch ~/.config/nvim/lua/config/basic.lua
touch ~/.config/nvim/lua/config/keymaps.lua

c).add config setting
//add to init.lua
require("config.basic")
require("config.keymaps")
require("config.lazy")

//目录结构如下：
~/.config/nvim$ tree .
.
├── init.lua
├── lazy-lock.json
└── lua
    └── config
        ├── basic.lua
        ├── keymaps.lua
        ├── lazy.lua
        └── plugins

------------------ other tools ------------------
1.fzf
a). install 
git clone --depth 1 https://github.com/junegunn/fzf.git ~/.fzf
~/.fzf/install

b).vim .fzf.bash to add fzf preview setting
vim .fzf.bash
//add preview setting like this
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --preview '(highlight -O ansi {} || cat {}) 2> /dev/null | head -500'"

c).source cmd to enable fzf
source ~/.bashrc
